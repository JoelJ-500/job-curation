# ---------------------------------------------------------------------------
# job-curation — environment settings
# Copy this file to .env and fill in real values: `cp .env.example .env`
# `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# PostgreSQL + pgvector (Docker) connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=job_curation
POSTGRES_PASSWORD=change_me
POSTGRES_DB=job_curation

# ---------------------------------------------------------------------------
# Backend / Agent 1 (user data extraction) — LLM: Groq
# ---------------------------------------------------------------------------

# Groq API key (free tier available at https://console.groq.com/keys).
GROQ_API_KEY=your_key_here

# Groq text model used for profile extraction and reading text documents.
GROQ_MODEL=openai/gpt-oss-120b

# Groq vision model used to read images and scanned PDFs, because GPT-OSS is
# text-only. On the Groq free tier the vision-capable model is qwen/qwen3.8-27b.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Where uploaded documents are stored (inside the backend container).
UPLOAD_DIR=/app/data/uploads

# Curated-queue output files (Agent 2, Step 1 — one text file per run).
QUEUE_DIR=/app/data/queue

# Selenium / Chromium used by the scrapers (set in the Docker image).
CHROME_BIN=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver
# Run the scrapers headless (true) or headed (false).
HEADLESS_BROWSER=true

# Compute the users.profile_embedding vector during extraction. Off by default
# because it pulls in the sentence-transformers model (used by Agent 2).
ENABLE_PROFILE_EMBEDDING=false

