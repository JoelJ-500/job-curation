# Frontend environment settings. Copy to `.env` (which is gitignored).
#
# When true, the UI uses an in-memory mock data layer (simulated document
# extraction) so the profile page works before the LangChain agent/backend exist.
# Set to false once the real backend endpoints are available.
VITE_USE_MOCK_API=true

# Base path for API requests. The Vite dev server proxies this to the backend.
VITE_API_BASE_URL=/api
